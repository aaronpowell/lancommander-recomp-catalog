<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The plugin is dropped into the server's Plugins folder; it serves no static web assets. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hex1bCatalog.Core\Hex1bCatalog.Core.csproj" />
    <ProjectReference Include="..\Hex1bCatalog.Providers\Hex1bCatalog.Providers.csproj" />
  </ItemGroup>

  <!--
    Host contract and UI assemblies are compile-time only (Private="false"). The server already
    has them loaded, so the plugin must not ship private copies with conflicting type identities.
  -->
  <ItemGroup>
    <Reference Include="LANCommander.SDK" HintPath="$(LANCommanderSdkArtifacts)\LANCommander.SDK.dll" Private="false" />
    <Reference Include="LANCommander.Server.Plugins" HintPath="$(LANCommanderServerPluginsArtifacts)\LANCommander.Server.Plugins.dll" Private="false" />
    <Reference Include="LANCommander.Server.UI" HintPath="$(LANCommanderServerUIArtifacts)\LANCommander.Server.UI.dll" Private="false" />
    <Reference Include="LANCommander.Server.Services" HintPath="$(LANCommanderServerServicesArtifacts)\LANCommander.Server.Services.dll" Private="false" />
    <Reference Include="LANCommander.Server.Data" HintPath="$(LANCommanderServerDataArtifacts)\LANCommander.Server.Data.dll" Private="false" />
    <Reference Include="LANCommander.Packaging" HintPath="$(LANCommanderPackagingArtifacts)\LANCommander.Packaging.dll" Private="false" />
    <Reference Include="LANCommander.Packaging.Abstractions" HintPath="$(LANCommanderPackagingAbstractionsArtifacts)\LANCommander.Packaging.Abstractions.dll" Private="false" />
  </ItemGroup>

  <Target Name="RequireLANCommanderPluginAssemblies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(LANCommanderSdkArtifacts)\LANCommander.SDK.dll')"
           Text="LANCommander.SDK.dll was not found. Build the pinned LANCommander source and set LANCommanderRoot. See README.md." />
    <Error Condition="!Exists('$(LANCommanderServerPluginsArtifacts)\LANCommander.Server.Plugins.dll')"
           Text="LANCommander.Server.Plugins.dll was not found. Build the pinned LANCommander source and set LANCommanderRoot. See README.md." />
    <Error Condition="!Exists('$(LANCommanderServerUIArtifacts)\LANCommander.Server.UI.dll')"
           Text="LANCommander.Server.UI.dll was not found. Build LANCommander.Server.UI and set LANCommanderRoot. See README.md." />
    <Error Condition="!Exists('$(LANCommanderServerServicesArtifacts)\LANCommander.Server.Services.dll')"
           Text="LANCommander.Server.Services.dll was not found. Build the pinned LANCommander source and set LANCommanderRoot. See README.md." />
    <Error Condition="!Exists('$(LANCommanderServerDataArtifacts)\LANCommander.Server.Data.dll')"
           Text="LANCommander.Server.Data.dll was not found. Build the pinned LANCommander source and set LANCommanderRoot. See README.md." />
    <Error Condition="!Exists('$(LANCommanderPackagingArtifacts)\LANCommander.Packaging.dll')"
           Text="LANCommander.Packaging.dll was not found. Build the pinned LANCommander source and set LANCommanderRoot. See README.md." />
    <Error Condition="!Exists('$(LANCommanderPackagingAbstractionsArtifacts)\LANCommander.Packaging.Abstractions.dll')"
           Text="LANCommander.Packaging.Abstractions.dll was not found. Build the pinned LANCommander source and set LANCommanderRoot. See README.md." />
  </Target>

</Project>
