<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.4.0</Version>
    <!-- Keep the git SHA out of the reported plugin version. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The plugin is dropped into the server's Plugins folder; it serves no static web assets. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="LANCommander.RecompCatalog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LANCommander.RecompCatalog.Core\LANCommander.RecompCatalog.Core.csproj" />
    <ProjectReference Include="..\LANCommander.RecompCatalog.Infrastructure\LANCommander.RecompCatalog.Infrastructure.csproj" />
    <ProjectReference Include="..\LANCommander.RecompCatalog.Providers\LANCommander.RecompCatalog.Providers.csproj" />
  </ItemGroup>

  <!--
    Host contract and UI assemblies are compile-time only. The server already has them loaded, so the
    plugin must not ship private copies with conflicting type identities.
  -->
  <ItemGroup>
    <PackageReference Include="LANCommander.SDK" Version="$(LANCommanderPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="LANCommander.Server.Plugins" Version="$(LANCommanderPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="LANCommander.Server.UI" Version="$(LANCommanderPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
