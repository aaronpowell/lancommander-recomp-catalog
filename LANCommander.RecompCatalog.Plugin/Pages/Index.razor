@page "/Plugins/RecompCatalog"
@attribute [PluginAccess(PluginAccessLevel.Administrator)]

<PageTitle>Recomp Catalog</PageTitle>

<PageHeader Title="Recomp Catalog" Subtitle="LANCommander server plugin" />

<PageContent>
    <Alert Info Title="Plugin UI is connected">
        This page is rendered with controls from <Typography Code>LANCommander.Server.UI.Controls</Typography>.
        Catalog feed integration is intentionally not part of this phase.
    </Alert>

    <Card Title="Plugin status" Subtitle="Host-provided UI assembly">
        <dl>
            <dt>Plugin</dt>
            <dd>@_plugin.Name v@_plugin.Version by @_plugin.Author</dd>

            <dt>Plugin id</dt>
            <dd><Typography Code>@_plugin.Id</Typography></dd>

            <dt>Assembly</dt>
            <dd><Typography Code>@_assembly.GetName().Name</Typography></dd>

            <dt>Load context</dt>
            <dd><Typography Code>@(AssemblyLoadContext.GetLoadContext(_assembly)?.Name ?? "default")</Typography></dd>
        </dl>
    </Card>
</PageContent>

@code {
    static readonly RecompCatalogPlugin _plugin = new();
    static readonly System.Reflection.Assembly _assembly = typeof(RecompCatalogPlugin).Assembly;
}
