@page "/Plugins/RecompCatalog"
@attribute [Authorize(Roles = LANCommander.SDK.Roles.Administrator)]

<PageTitle>Recomp Catalog</PageTitle>

<h1>Hello, your plugin is installed</h1>

<p>
    This page is served from an assembly loaded out of the server's <code>Plugins</code> folder,
    which confirms plugin discovery, the route assembly contract, and navigation registration all work.
</p>

<dl>
    <dt>Plugin</dt>
    <dd>@_plugin.Name v@_plugin.Version by @_plugin.Author</dd>

    <dt>Plugin id</dt>
    <dd>@_plugin.Id</dd>

    <dt>Assembly</dt>
    <dd>@_assembly.GetName().Name</dd>

    <dt>Load context</dt>
    <dd>@(AssemblyLoadContext.GetLoadContext(_assembly)?.Name ?? "default")</dd>

    <dt>Rendered at</dt>
    <dd>@DateTimeOffset.Now.ToString("u")</dd>
</dl>

@code {
    static readonly RecompCatalogPlugin _plugin = new();
    static readonly System.Reflection.Assembly _assembly = typeof(RecompCatalogPlugin).Assembly;
}
