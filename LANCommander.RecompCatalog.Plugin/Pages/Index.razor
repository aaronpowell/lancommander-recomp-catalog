@page "/Plugins/RecompCatalog"
@attribute [PluginAccess(PluginAccessLevel.Administrator)]
@implements IAsyncDisposable
@inject CatalogBrowserService Browser
@inject RecompCatalogSettings Settings
@inject ICatalogHostIntegration Host

<PageTitle>Recomp Catalog</PageTitle>

<PageHeader Title="Recomp Catalog" Subtitle="Browse compatible community recompilation feeds">
    <Extra>
        <Button Icon="IconType.ArrowClockwise" OnClick="ReloadAsync">
            Reload
        </Button>
    </Extra>
</PageHeader>

<PageContent>
    <Alert Info Title="Independent catalog browser">
        This plugin is independent of Quiver. It consumes a compatible public feed as untrusted
        remote data and does not bundle a catalog snapshot.
    </Alert>

    @if (_catalog.Status == CatalogBrowserStatus.Loading)
    {
        <Card>
            <Spin Tip="Loading recomp catalog..." />
        </Card>
    }
    else if (_catalog.Status == CatalogBrowserStatus.Unconfigured)
    {
        <Result Warning
                Title="Catalog feed is not configured"
                SubTitle="@($"Set {RecompCatalogSettings.FeedConfigurationKey} to an HTTPS catalog index URL, then reload.")" />
    }
    else if (_catalog.Status == CatalogBrowserStatus.Failed)
    {
        <Alert Danger Title="Catalog load failed">
            <div>@_catalog.ErrorMessage</div>
            <Button Small Icon="IconType.ArrowClockwise" OnClick="ReloadAsync" Style="margin-top: 8px">
                Retry
            </Button>
        </Alert>
    }
    else if (_catalog.Status == CatalogBrowserStatus.Empty)
    {
        <Empty Title="The catalog is empty"
               Description="The configured feed loaded successfully but did not contain any usable entries." />
    }
    else
    {
        <Card Title="Filters" Subtitle="@($"{_filtered.Count:N0} of {_catalog.Entries.Count:N0} entries")">
            <Row Gap="Gap.Medium" VerticalGap="Gap.Medium">
                <Column Xs="24" Md="12" Lg="8">
                    <TextInput Icon="IconType.MagnifyingGlass"
                               Immediate
                               Value="@_query"
                               ValueChanged="SearchChanged"
                               Placeholder="Search title, project, repository, or tag" />
                </Column>
                <Column Xs="24" Md="12" Lg="6">
                    <Select TValue="string"
                            Items="@TagOptions"
                            Value="@_tag"
                            ValueChanged="TagChanged"
                            Searchable />
                </Column>
                <Column Xs="24" Md="12" Lg="5">
                    <Select TValue="string"
                            Items="@OriginalPlatformOptions"
                            Value="@_originalPlatform"
                            ValueChanged="OriginalPlatformChanged" />
                </Column>
                @if (_catalog.TargetPlatforms.Count > 0)
                {
                    <Column Xs="24" Md="12" Lg="5">
                        <Select TValue="string"
                                Items="@TargetPlatformOptions"
                                Value="@_targetPlatform"
                                ValueChanged="TargetPlatformChanged" />
                    </Column>
                }
                <Column Xs="24" Md="12" Lg="5">
                    <Select TValue="string"
                            Items="@ImportStateOptions"
                            Value="@_importState"
                            ValueChanged="ImportStateChanged" />
                </Column>
            </Row>
        </Card>

        @if (_filtered.Count == 0)
        {
            <Empty Title="No matching recomp projects"
                   Description="Clear or change the current search and filters." />
        }
        else
        {
            <Row Gap="Gap.Medium" VerticalGap="Gap.Medium">
                <Column Xs="24" Lg="14">
                    <Card Title="Catalog entries" Count="@_filtered.Count">
                        @foreach (var entry in _filtered)
                        {
                            <Card Small Borderless
                                  Title="@entry.DisplayName"
                                  Subtitle="@entry.CatalogEntry.Repository"
                                  Style="margin-bottom: 8px">
                                <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 8px">
                                    <Tag Caps Small>@entry.OriginalPlatform</Tag>
                                    <Tag Small>@StateLabel(entry.ImportState.Status)</Tag>
                                    @foreach (var tag in entry.CatalogEntry.Tags.Take(6))
                                    {
                                        <Tag>@tag</Tag>
                                    }
                                </div>
                                <Button Small
                                        Primary="@(ReferenceEquals(_selected, entry))"
                                        OnClick="() => SelectEntry(entry)">
                                    View details
                                </Button>
                            </Card>
                        }
                    </Card>
                </Column>

                <Column Xs="24" Lg="10">
                    @if (_selected is null)
                    {
                        <Card Title="Project details">
                            <Empty Small
                                   Title="Select a project"
                                   Description="Choose a catalog entry to inspect its provenance and release preview." />
                        </Card>
                    }
                    else
                    {
                        <Card Title="@_selected.DisplayName" Subtitle="@_selected.CatalogEntry.Project">
                            <dl>
                                <dt>Original platform</dt>
                                <dd>@_selected.OriginalPlatform</dd>

                                <dt>Target platforms</dt>
                                <dd>@DisplayTargets(_selected)</dd>

                                <dt>Repository provider</dt>
                                <dd>@RepositoryProvider(_selected)</dd>

                                <dt>Repository</dt>
                                <dd><Typography Code>@_selected.CatalogEntry.Repository</Typography></dd>

                                <dt>Feed provenance</dt>
                                <dd><Typography Code>@_selected.SourceLocation</Typography></dd>

                                <dt>Release asset filter</dt>
                                <dd>@(_selected.CatalogEntry.ReleaseAssetFilter ?? "None")</dd>

                                <dt>Import status</dt>
                                <dd>@StateLabel(_selected.ImportState.Status)</dd>

                                @if (_selected.ImportState.Imported is not null)
                                {
                                    <dt>LANCommander game</dt>
                                    <dd>@_selected.ImportState.Imported.GameTitle</dd>

                                    <dt>Imported release</dt>
                                    <dd>@DisplayImportedRelease(_selected.ImportState.Imported)</dd>
                                }
                            </dl>

                            <div style="display: flex; flex-wrap: wrap; gap: 8px">
                                @if (_selected.RepositoryUrl is not null)
                                {
                                    <Button Href="@_selected.RepositoryUrl.ToString()"
                                            NewTab
                                            Icon="IconType.GithubLogo">
                                        Open repository
                                    </Button>
                                }
                                <Button Primary
                                        Icon="IconType.Package"
                                        Disabled="@(!_selected.CatalogEntry.IsGitHub)"
                                        Loading="@(_preview?.Status == ImportPreviewStatus.Loading)"
                                        OnClick="OpenPreviewAsync">
                                    Check release and prepare
                                </Button>
                            </div>

                            @if (!_selected.CatalogEntry.IsGitHub)
                            {
                                <Alert Warning Title="Preview unavailable" Style="margin-top: 12px">
                                    Release preview currently supports GitHub repositories only.
                                </Alert>
                            }
                        </Card>

                        @if (_preview is not null)
                        {
                            <Card Title="Import preview" Subtitle="No binaries have been downloaded" Style="margin-top: 16px">
                                @if (_preview.Status == ImportPreviewStatus.Loading)
                                {
                                    <Spin Tip="Resolving the latest release metadata..." />
                                }
                                else if (_preview.Status is ImportPreviewStatus.Failed or ImportPreviewStatus.Unsupported)
                                {
                                    <Alert Danger Title="Release preview failed">
                                        @_preview.Message
                                    </Alert>
                                }
                                else if (_preview.Release is not null)
                                {
                                    <dl>
                                        <dt>Release</dt>
                                        <dd>@_preview.Release.Name</dd>

                                        <dt>Tag</dt>
                                        <dd><Typography Code>@_preview.Release.Tag</Typography></dd>

                                        <dt>Published</dt>
                                        <dd>@DisplayDate(_preview.Release.PublishedAt)</dd>

                                        <dt>Selectable Windows assets</dt>
                                        <dd>@_preview.Release.Assets.Count</dd>
                                    </dl>

                                    @foreach (var asset in _preview.Release.Assets)
                                    {
                                        <Card Small Borderless
                                              Title="@asset.Name"
                                              Subtitle="@FormatSize(asset.Size)"
                                              Style="margin-bottom: 8px">
                                            <Button Small
                                                    Primary
                                                    OnClick="() => BeginPreparation(asset)">
                                                Prepare this asset
                                            </Button>
                                        </Card>
                                    }

                                    @if (_preparation is not null)
                                    {
                                        <Card Title="Import preparation" Subtitle="Catalog and release provenance are retained" Style="margin-top: 12px">
                                            <dl>
                                                <dt>Canonical catalog identity</dt>
                                                <dd><Typography Code>@_preparation.Provenance.Catalog.Value</Typography></dd>

                                                <dt>Exact release</dt>
                                                <dd><Typography Code>@_preparation.Provenance.Release?.Value</Typography></dd>

                                                <dt>Selected asset</dt>
                                                <dd>@_preparation.Asset.Name</dd>
                                            </dl>

                                            @if (_metadataProviders.Count == 0)
                                            {
                                                <Alert Warning Title="Metadata lookup is unavailable">
                                                    LANCommander has no configured metadata providers. Configure a provider
                                                    in the server, then restart or reload this page.
                                                </Alert>
                                            }
                                            else
                                            {
                                                <Row Gap="Gap.Medium" VerticalGap="Gap.Medium">
                                                    <Column Xs="24" Md="8">
                                                        <Select TValue="string"
                                                                Items="@MetadataProviderOptions"
                                                                Value="@_metadataProvider"
                                                                ValueChanged="MetadataProviderChanged" />
                                                    </Column>
                                                    <Column Xs="24" Md="12">
                                                        <TextInput Value="@_metadataQuery"
                                                                   ValueChanged="value => _metadataQuery = value"
                                                                   Placeholder="Search LANCommander metadata providers" />
                                                    </Column>
                                                    <Column Xs="24" Md="4">
                                                        <Button Primary
                                                                Loading="@_metadataLoading"
                                                                Disabled="@string.IsNullOrWhiteSpace(_metadataProvider)"
                                                                OnClick="SearchMetadataAsync">
                                                            Lookup
                                                        </Button>
                                                    </Column>
                                                </Row>

                                                @if (!string.IsNullOrWhiteSpace(_metadataError))
                                                {
                                                    <Alert Danger Title="Metadata lookup failed">
                                                        @_metadataError
                                                    </Alert>
                                                }

                                                @foreach (var result in _metadataResults)
                                                {
                                                    <Card Small Borderless
                                                          Title="@result.Title"
                                                          Subtitle="@result.Provider"
                                                          Style="margin-top: 8px">
                                                        <Button Small
                                                                Loading="@_metadataLoading"
                                                                OnClick="() => SelectMetadataAsync(result)">
                                                            Review metadata
                                                        </Button>
                                                    </Card>
                                                }

                                                @if (_preparation.Metadata is not null)
                                                {
                                                    <Card Small Title="Lookup metadata review" Style="margin-top: 12px">
                                                        <dl>
                                                            <dt>Title</dt>
                                                            <dd>@_preparation.Metadata.Title</dd>
                                                            <dt>Description</dt>
                                                            <dd>@DisplayValue(_preparation.Metadata.Description)</dd>
                                                            <dt>Released</dt>
                                                            <dd>@(_preparation.Metadata.ReleasedOn?.ToString("yyyy-MM-dd") ?? "Not supplied")</dd>
                                                            <dt>Engine</dt>
                                                            <dd>@DisplayValue(_preparation.Metadata.Engine)</dd>
                                                            <dt>Developers</dt>
                                                            <dd>@DisplayList(_preparation.Metadata.Developers)</dd>
                                                            <dt>Genres</dt>
                                                            <dd>@DisplayList(_preparation.Metadata.Genres)</dd>
                                                            <dt>Tags</dt>
                                                            <dd>@DisplayList(_preparation.Metadata.Tags)</dd>
                                                            <dt>External IDs</dt>
                                                            <dd>@DisplayList(_preparation.Metadata.ExternalIds)</dd>
                                                        </dl>
                                                    </Card>
                                                }
                                            }

                                            <Alert Warning Title="Confirmation is not available yet">
                                                Preparation now captures catalog, exact release, asset policy, and optional
                                                LANCommander lookup metadata. Final confirmation remains disabled until the
                                                safe download, normalization, executable selection, and LCX ingestion path
                                                is connected to the server.
                                            </Alert>
                                            <Button Primary Disabled Icon="IconType.Download">Confirm import</Button>
                                        </Card>
                                    }
                                }
                            </Card>
                        }
                    }
                </Column>
            </Row>
        }
    }
</PageContent>

@code {
    readonly CancellationTokenSource _lifetime = new();
    CancellationTokenSource? _operation;
    CatalogBrowserResult _catalog = new(
        CatalogBrowserStatus.Loading,
        null,
        [],
        [],
        [],
        []);
    IReadOnlyList<CatalogBrowserEntry> _filtered = [];
    CatalogBrowserEntry? _selected;
    ImportPreview? _preview;
    ImportPreparation? _preparation;
    IReadOnlyList<string> _metadataProviders = [];
    IReadOnlyList<MetadataLookupResult> _metadataResults = [];
    string _metadataProvider = "";
    string _metadataQuery = "";
    string? _metadataError;
    bool _metadataLoading;
    string _query = "";
    string _tag = "";
    string _originalPlatform = "";
    string _targetPlatform = "";
    string _importState = "";

    IEnumerable<SelectItem<string>> TagOptions =>
        Options("All tags", _catalog.Tags);

    IEnumerable<SelectItem<string>> OriginalPlatformOptions =>
        Options("All original platforms", _catalog.OriginalPlatforms);

    IEnumerable<SelectItem<string>> TargetPlatformOptions =>
        Options("All target platforms", _catalog.TargetPlatforms);

    IEnumerable<SelectItem<string>> ImportStateOptions =>
    [
        new("", "All import states"),
        .. Enum.GetValues<CatalogEntryState>()
            .Select(state => new SelectItem<string>(state.ToString(), StateLabel(state))),
    ];

    IEnumerable<SelectItem<string>> MetadataProviderOptions =>
        Options("Choose provider", _metadataProviders);

    protected override Task OnInitializedAsync() => ReloadAsync();

    async Task ReloadAsync()
    {
        var operation = BeginOperation();
        _catalog = new CatalogBrowserResult(
            CatalogBrowserStatus.Loading,
            null,
            [],
            [],
            [],
            []);
        _selected = null;
        _preview = null;

        try
        {
            _catalog = await Browser.LoadAsync(Settings.FeedUrl, operation.Token);
            if (_catalog.Status == CatalogBrowserStatus.Ready)
                await LoadImportedStatesAsync(operation.Token);
            ClampFacetFilters();
            ApplyFilter();
        }
        catch (OperationCanceledException) when (operation.IsCancellationRequested)
        {
        }
        finally
        {
            CompleteOperation(operation);
        }
    }

    void SearchChanged(string value)
    {
        _query = value;
        ApplyFilter();
    }

    void TagChanged(string value)
    {
        _tag = value;
        ApplyFilter();
    }

    void OriginalPlatformChanged(string value)
    {
        _originalPlatform = value;
        ApplyFilter();
    }

    void TargetPlatformChanged(string value)
    {
        _targetPlatform = value;
        ApplyFilter();
    }

    void ImportStateChanged(string value)
    {
        _importState = value;
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _filtered = CatalogBrowserService.ApplyFilter(
            _catalog.Entries,
            new CatalogBrowserFilter(
                _query,
                _tag,
                _originalPlatform,
                _targetPlatform,
                Enum.TryParse<CatalogEntryState>(_importState, out var state) ? state : null));

        if (_selected is not null && !_filtered.Contains(_selected))
        {
            _operation?.Cancel();
            _selected = null;
            _preview = null;
        }
    }

    void SelectEntry(CatalogBrowserEntry entry)
    {
        _operation?.Cancel();
        _selected = entry;
        _preview = null;
        ResetPreparation();
    }

    async Task OpenPreviewAsync()
    {
        if (_selected is null)
            return;

        var entry = _selected;
        var operation = BeginOperation();
        _preview = new ImportPreview(ImportPreviewStatus.Loading, entry);

        try
        {
            var preview = await Browser.PreviewImportAsync(entry, operation.Token);
            if (ReferenceEquals(_selected, entry))
            {
                _preview = preview;
                ApplyReleaseCheck(entry, preview);
            }
        }
        catch (OperationCanceledException) when (operation.IsCancellationRequested)
        {
        }
        finally
        {
            CompleteOperation(operation);
        }
    }

    async Task LoadImportedStatesAsync(CancellationToken cancellationToken)
        {
            try
            {
                var states = await Host.LoadImportedStatesAsync(_catalog.Entries, cancellationToken);
                _catalog = _catalog with
                {
                    Entries = _catalog.Entries
                        .Select(entry => entry with
                        {
                            ImportState = states.TryGetValue(entry.Id, out var state)
                                ? state
                                : CatalogEntryStateView.NeverImported(),
                        })
                        .ToList(),
                };
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                throw;
            }
            catch (Exception ex)
            {
                _catalog = _catalog with
                {
                    Entries = _catalog.Entries
                        .Select(entry => entry with
                        {
                            ImportState = CatalogEntryStateClassifier.Classify(
                                null,
                                failure: ex.Message),
                        })
                        .ToList(),
                };
            }
        }

        void ApplyReleaseCheck(CatalogBrowserEntry entry, ImportPreview preview)
        {
            if (entry.ImportState.Imported is null)
                return;

            CatalogEntryStateView state;
            if (preview.Status == ImportPreviewStatus.Ready && preview.Release is not null)
            {
                var selectedAssetName = entry.ImportState.Imported.UpdatePolicy?.SelectedAssetName;
                var asset = preview.Release.Assets.FirstOrDefault(candidate =>
                        candidate.Name.Equals(selectedAssetName, StringComparison.OrdinalIgnoreCase))
                    ?? preview.Release.Assets.First();
                state = CatalogEntryStateClassifier.Classify(
                    entry.ImportState.Imported,
                    ReleaseIdentity.Create(entry.Identity, preview.Release, asset));
            }
            else
            {
                state = CatalogEntryStateClassifier.Classify(
                    entry.ImportState.Imported,
                    failure: preview.Message ?? "Release state could not be checked.");
            }

            UpdateEntryState(entry, state);
        }

        void UpdateEntryState(CatalogBrowserEntry entry, CatalogEntryStateView state)
        {
            var updated = entry with { ImportState = state };
            _catalog = _catalog with
            {
                Entries = _catalog.Entries
                    .Select(candidate => candidate.Id == entry.Id ? updated : candidate)
                    .ToList(),
            };
            _selected = updated;
            ApplyFilter();
        }

        void BeginPreparation(ReleaseAsset asset)
        {
            if (_selected is null || _preview?.Release is null)
                return;

            var release = _preview.Release;
            var releaseIdentity = ReleaseIdentity.Create(_selected.Identity, release, asset);
            var policy = new PackageUpdatePolicy(
                _selected.Identity.RepositoryProvider,
                _selected.Identity.Repository,
                _selected.CatalogEntry.ReleaseAssetFilter,
                asset.Name,
                Path.GetExtension(asset.Name).TrimStart('.').ToLowerInvariant(),
                true);
            var provenance = new CatalogImportProvenance(
                StableId.Create(
                    $"game:{_selected.CatalogEntry.Repository.ToLowerInvariant()}:{_selected.CatalogEntry.Name}"),
                _selected.CatalogEntry.Name,
                _selected.Identity,
                release.Tag,
                releaseIdentity,
                policy);

            _preparation = new ImportPreparation(_selected, release, asset, provenance);
            _metadataProviders = Host.GetMetadataProviders();
            _metadataProvider = _metadataProviders.FirstOrDefault() ?? "";
            _metadataQuery = _selected.CatalogEntry.Name;
            _metadataResults = [];
            _metadataError = null;
        }

        async Task SearchMetadataAsync()
        {
            if (string.IsNullOrWhiteSpace(_metadataProvider)
                || string.IsNullOrWhiteSpace(_metadataQuery))
                return;

            _metadataLoading = true;
            _metadataError = null;
            _metadataResults = [];
            try
            {
                _metadataResults = await Host.SearchMetadataAsync(
                    _metadataProvider,
                    _metadataQuery,
                    _lifetime.Token);
            }
            catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
            {
            }
            catch (Exception ex)
            {
                _metadataError = ex.Message;
            }
            finally
            {
                _metadataLoading = false;
            }
        }

        async Task SelectMetadataAsync(MetadataLookupResult result)
        {
            if (_preparation is null)
                return;

            _metadataLoading = true;
            _metadataError = null;
            try
            {
                var metadata = await Host.GetMetadataAsync(
                    result.Provider,
                    result.ProviderGameId,
                    _lifetime.Token);
                if (metadata is null)
                {
                    _metadataError = "The metadata provider returned no game details.";
                    return;
                }

                _preparation = ImportPreparationMerger.ApplyMetadata(_preparation, metadata);
            }
            catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
            {
            }
            catch (Exception ex)
            {
                _metadataError = ex.Message;
            }
            finally
            {
                _metadataLoading = false;
            }
        }

        void MetadataProviderChanged(string value)
        {
            _metadataProvider = value;
            _metadataResults = [];
            _metadataError = null;
        }

        void ResetPreparation()
        {
            _preparation = null;
            _metadataProviders = [];
            _metadataResults = [];
            _metadataProvider = "";
            _metadataQuery = "";
            _metadataError = null;
    }

    CancellationTokenSource BeginOperation()
    {
        _operation?.Cancel();
        _operation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        return _operation;
    }

    void CompleteOperation(CancellationTokenSource operation)
    {
        if (ReferenceEquals(_operation, operation))
            _operation = null;

        operation.Dispose();
    }

    void ClampFacetFilters()
    {
        if (!_catalog.Tags.Contains(_tag, StringComparer.OrdinalIgnoreCase))
            _tag = "";
        if (!_catalog.OriginalPlatforms.Contains(_originalPlatform, StringComparer.OrdinalIgnoreCase))
            _originalPlatform = "";
        if (!_catalog.TargetPlatforms.Contains(_targetPlatform, StringComparer.OrdinalIgnoreCase))
            _targetPlatform = "";
        if (!Enum.TryParse<CatalogEntryState>(_importState, out _))
            _importState = "";
    }

    static IEnumerable<SelectItem<string>> Options(
        string allLabel,
        IEnumerable<string> values) =>
        [new SelectItem<string>("", allLabel), .. values.Select(value => new SelectItem<string>(value, value))];

    static string DisplayTargets(CatalogBrowserEntry entry) =>
        entry.TargetPlatforms.Count == 0
            ? "Not declared by feed"
            : string.Join(", ", entry.TargetPlatforms);

    static string RepositoryProvider(CatalogBrowserEntry entry) =>
        string.IsNullOrWhiteSpace(entry.CatalogEntry.RepositorySource)
            ? "GitHub"
            : entry.CatalogEntry.RepositorySource;

    static string DisplayDate(DateTimeOffset? date) =>
        date?.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Not supplied";

    static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:N1} MiB"
            : $"{bytes / 1024d:N1} KiB";

    static string StateLabel(CatalogEntryState state) => state switch
    {
        CatalogEntryState.NeverImported => "Never imported",
        CatalogEntryState.ImportedCurrent => "Imported / current",
        CatalogEntryState.UpdateAvailable => "Update available",
        CatalogEntryState.ImportedReleaseUnknown => "Imported release unknown",
        CatalogEntryState.StateCheckFailed => "State check failed",
        _ => state.ToString(),
    };

    static string DisplayImportedRelease(CatalogImportProvenance imported) =>
        imported.Release?.Tag
        ?? (string.IsNullOrWhiteSpace(imported.ImportedTag) ? "Unknown" : imported.ImportedTag);

    static string DisplayValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not supplied" : value;

    static string DisplayList(IEnumerable<string> values) =>
        values.Any() ? string.Join(", ", values) : "Not supplied";

    public ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        _operation?.Cancel();
        _lifetime.Dispose();
        return ValueTask.CompletedTask;
    }
}
