<Project>
  <PropertyGroup>
    <LANCommanderRoot Condition="'$(LANCommanderRoot)' == '' and '$(LANCOMMANDER_ROOT)' != ''">$(LANCOMMANDER_ROOT)</LANCommanderRoot>
    <LANCommanderRoot Condition="'$(LANCommanderRoot)' == ''">D:\copilot-app\copilot-worktrees\LANCommander\aaronpowell-potential-funicular</LANCommanderRoot>
    <LANCommanderSdkArtifacts Condition="'$(LANCommanderSdkArtifacts)' == ''">$(LANCommanderRoot)\LANCommander.SDK\bin\Debug\net10.0</LANCommanderSdkArtifacts>
    <LANCommanderServerPluginsArtifacts Condition="'$(LANCommanderServerPluginsArtifacts)' == ''">$(LANCommanderRoot)\LANCommander.Server.Plugins\bin\Debug\net10.0</LANCommanderServerPluginsArtifacts>
    <LANCommanderServerUIArtifacts Condition="'$(LANCommanderServerUIArtifacts)' == ''">$(LANCommanderRoot)\LANCommander.Server.UI\bin\Debug\net10.0</LANCommanderServerUIArtifacts>
    <LANCommanderServerServicesArtifacts Condition="'$(LANCommanderServerServicesArtifacts)' == ''">$(LANCommanderRoot)\LANCommander.Server.Services\bin\Debug\net10.0</LANCommanderServerServicesArtifacts>
    <LANCommanderServerDataArtifacts Condition="'$(LANCommanderServerDataArtifacts)' == ''">$(LANCommanderRoot)\LANCommander.Server.Data\bin\Debug\net10.0</LANCommanderServerDataArtifacts>
    <LANCommanderServerImportExportArtifacts Condition="'$(LANCommanderServerImportExportArtifacts)' == ''">$(LANCommanderRoot)\LANCommander.Server.ImportExport\bin\Debug\net10.0</LANCommanderServerImportExportArtifacts>
  </PropertyGroup>
</Project>
