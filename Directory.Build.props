<Project>
  <PropertyGroup>
    <LANCommanderRoot Condition="'$(LANCommanderRoot)' == '' and '$(LANCOMMANDER_ROOT)' != ''">$(LANCOMMANDER_ROOT)</LANCommanderRoot>
    <LANCommanderRoot Condition="'$(LANCommanderRoot)' == ''">D:\copilot-app\copilot-worktrees\LANCommander\aaronpowell-potential-funicular</LANCommanderRoot>
    <LANCommanderSdkArtifacts Condition="'$(LANCommanderSdkArtifacts)' == ''">$(LANCommanderRoot)\LANCommander.SDK\bin\Debug\net10.0</LANCommanderSdkArtifacts>
    <LANCommanderPackagingArtifacts Condition="'$(LANCommanderPackagingArtifacts)' == ''">$(LANCommanderRoot)\LANCommander.Packaging\bin\Debug\net10.0</LANCommanderPackagingArtifacts>
    <LANCommanderPackagingAbstractionsArtifacts Condition="'$(LANCommanderPackagingAbstractionsArtifacts)' == ''">$(LANCommanderRoot)\LANCommander.Packaging.Abstractions\bin\Debug\net10.0</LANCommanderPackagingAbstractionsArtifacts>
