<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LANCommander.RecompCatalog.Core\LANCommander.RecompCatalog.Core.csproj" />
    <ProjectReference Include="..\LANCommander.RecompCatalog.Infrastructure\LANCommander.RecompCatalog.Infrastructure.csproj" />
    <ProjectReference Include="..\LANCommander.RecompCatalog.Providers\LANCommander.RecompCatalog.Providers.csproj" />
    <ProjectReference Include="..\LANCommander.RecompCatalog.Plugin\LANCommander.RecompCatalog.Plugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LANCommander.SDK" Version="$(LANCommanderPackageVersion)" />
    <PackageReference Include="LANCommander.Server.Plugins" Version="$(LANCommanderPackageVersion)" />
    <PackageReference Include="LANCommander.Server.UI" Version="$(LANCommanderPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
